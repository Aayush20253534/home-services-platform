# Phase 01 development only. Do not reuse these credentials in production.
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://home_services:localdevonly@localhost:5432/home_services?schema=public
REDIS_URL=redis://localhost:6379
# For Android emulator: http://10.0.2.2:4000 ; physical devices: your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phase 04 authentication. These values are development-only placeholders.
AUTH_JWT_SECRET=dev-only-jwt-secret-7a410e46ca395851a953d6a27bda
AUTH_OTP_SECRET=dev-only-otp-secret-5ca98b761e404ab48da38420660d
AUTH_REFRESH_SECRET=dev-only-refresh-secret-335e769ae7864b3a9ccb7c491e
AUTH_DEV_OTP=true
SMS_PROVIDER=dev-console
# For production: SMS_PROVIDER=twilio and valid account details.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TRUST_PROXY_HOPS=0

# Server-only admin dashboard -> API base URL (never NEXT_PUBLIC_).
AUTH_API_URL=http://localhost:4000
