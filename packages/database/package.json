{
  "name": "@home-services/database",
  "version": "0.3.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx prisma/verify.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "build": "pnpm db:generate && tsc --project tsconfig.build.json",
    "typecheck": "pnpm db:generate && tsc --noEmit --project tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
