{
  "name": "@home-services/customer",
  "version": "0.2.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@home-services/design-tokens": "workspace:*",
    "@home-services/mobile-ui": "workspace:*",
    "@expo/vector-icons": "^15.0.0",
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
