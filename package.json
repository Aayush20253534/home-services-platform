{
  "name": "home-services-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test && node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @home-services/database db:generate",
    "db:validate": "pnpm --filter @home-services/database db:validate",
    "db:migrate:dev": "pnpm --filter @home-services/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @home-services/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @home-services/database db:migrate:status",
    "db:seed": "pnpm --filter @home-services/database db:seed",
    "db:verify": "pnpm --filter @home-services/database db:verify",
    "db:studio": "pnpm --filter @home-services/database db:studio",
    "db:provision-admin": "pnpm --filter @home-services/database db:provision-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
